# Copy this file to .env and fill in real values. .env is gitignored.

# The Gmail account the quote form sends from (and defaults to sending to)
GMAIL_USER=sudzmobiledetailing8@gmail.com

# A Google App Password for GMAIL_USER, NOT the account password.
# Generate one at: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=

# Where quote request emails should land. Defaults to GMAIL_USER if omitted.
TO_EMAIL=sudzmobiledetailing8@gmail.com

PORT=3000
